# ==============================================================================
# CyberPulse — Global DDoS Intelligence Globe
# Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to '.env':
#      PowerShell: Copy-Item .env.example .env
# 2. Populate the required values below.
# 3. NEVER commit your actual '.env' file or API tokens to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (FastAPI / Uvicorn)
# ------------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Allowed CORS origins (comma-separated list for Vite dev server and local clients)
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# Cloudflare Radar API Configuration
#
# Create an API token in the Cloudflare Dashboard:
# Profile -> API Tokens -> Create Custom Token
# Permissions required:
#   - Account: Radar:Read (or Account Analytics:Read depending on account setup)
# ------------------------------------------------------------------------------
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_API_BASE_URL=https://api.cloudflare.com/client/v4/radar

# Backend Caching & Request Throttling
# Radar DDoS stats update periodically; a 10-15 minute TTL avoids rate limits
# and ensures instant responses for frontend dashboard users.
CACHE_TTL_SECONDS=900
RADAR_REQUEST_TIMEOUT_SECONDS=15
BACKEND_RATE_LIMIT_PER_MINUTE=60

# ------------------------------------------------------------------------------
# Frontend Configuration (Vite / React)
#
# Vite requires environment variables exposed to the client to be prefixed with VITE_
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_ENABLE_SIMULATED_EVENTS=true
