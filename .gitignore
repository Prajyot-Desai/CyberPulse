# ==============================================================================
# CyberPulse — Global DDoS Intelligence Globe
# Git Ignore Configuration
# ==============================================================================

# Virtual Environment (Python)
.venv/
venv/
env/
ENV/
*.venv

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Testing & Coverage (Python)
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.hypothesis/
.tox/

# Node.js & Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build Artifacts & Bundler Output
dist/
build/
out/
.vite/
*.tsbuildinfo

# Testing & Coverage (JavaScript / TypeScript)
coverage/
.nyc_output/

# Environment Variables & Local Secrets
# NEVER commit .env files containing real credentials
.env
.env.local
.env.*.local
*.env
!*.env.example

# IDE & Editor Specific Files
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Operating System Files
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# Logs & Temporary Files
*.log
logs/
temp/
tmp/
